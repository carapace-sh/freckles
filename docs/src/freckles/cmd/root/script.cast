[0.005, "o", "function _freckles_quote_suffix\r\n  if not commandline -cp | xargs echo 2>/dev/null >/dev/null\r\n    if commandline -cp | sed 's/$/\"/'| xargs echo 2>/dev/null >/dev/null\r\n      echo '\"'\r\n    else if commandline -cp | sed \"s/\\$/'/\"| xargs echo 2>/dev/null >/dev/null\r\n      echo \"'\"\r\n    end\r\n  else \r\n    echo \"\"\r\n  end\r\nend\r\n\r\nfunction _freckles_callback\r\n  commandline -cp | sed \"s/\\$/\"(_freckles_quote_suffix)\"/\" | sed \"s/ \\$/ ''/\" | xargs freckles _carapace fish\r\nend\r\n\r\ncomplete -e 'freckles'\r\ncomplete -c 'freckles' -f -a '(_freckles_callback)' -r\r\n\r\n"]
